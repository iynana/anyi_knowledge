		{"id":"bd2a3a2b296da65c","type":"text","text":"# Spring boot","x":-1115,"y":3062,"width":202,"height":58},
		{"id":"4044580ecd48c5c4","type":"file","file":"Spring框架/SpringBoot/SpringBoot 自动装配的原理.md","x":-665,"y":2791,"width":680,"height":300,"color":"3"},
		{"id":"1ac6861fe7194652","type":"file","file":"Spring框架/SpringBoot/SpringBoot启动流程.md","x":-1755,"y":2720,"width":450,"height":400,"color":"3"},
		{"id":"abad3061f7c979c4","type":"text","text":"# Springboot的优势\n+ Starter依赖引入\n+ 自动配置（根据当前项目依赖、环境和配置，自动帮你创建和初始化 Bean）\n+ 内嵌Tomcat（监听http接口，解析http协议，管理请求线程，管理Servlet生命周期）\n+ yml配置管理更方便，支持多环境隔离","x":-1755,"y":3200,"width":450,"height":240,"color":"1"},
		{"id":"a364fbaef2f5d987","type":"file","file":"Spring框架/SpringBoot/SpringBoot的过滤器和拦截器的区别.md","x":-695,"y":3250,"width":740,"height":140,"color":"4"},
