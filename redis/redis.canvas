		{"id":"2b0ad725554333c5","type":"text","text":"AOF缺点\n+ 占内存大\n+ 恢复慢","x":680,"y":600,"width":180,"height":110,"color":"3"},
		{"id":"b91282a374730ba6","type":"text","text":"AOF优点\n+ 记录的频率高","x":460,"y":600,"width":180,"height":110,"color":"3"},
		{"id":"4f2b06ae62cd1aaa","type":"text","text":"AOF应用\n+ 高可靠性业务\n+ 日志审计","x":1092,"y":88,"width":350,"height":112,"color":"4"},
		{"id":"1e5f7b85df655ff2","type":"text","text":"RDB应用\n+ 大规模数据恢复（直接加载数据，快）\n+ 数据备份","x":1092,"y":-60,"width":350,"height":114,"color":"3"},
		{"id":"9eb0c82995364d0f","type":"text","text":"# 为什么lua脚本可以实现原子性？\n+ redis单线程\n+ lua脚本一次性串行执行","x":3040,"y":-747,"width":420,"height":175,"color":"3"}
