		{"id":"9f2670216c729d87","type":"text","text":"# 应用场景\n+ 有接口默认使用JDK\n+ 无接口使用CGLIB","x":333,"y":54,"width":257,"height":133,"color":"3"},
		{"id":"b6dc60c43bbccb03","type":"text","text":"# 优点\n+ 轻量\n+ JDK原生支持\n+ 性能好（但CGLIB优化后已经不慢了）\n\n# 缺点\n+ 依赖接口\n+ JDK动态代理可能导致的类型转换异常","x":480,"y":-280,"width":360,"height":310,"color":"3"},
		{"id":"656f6d8e436561ff","type":"text","text":"# 优点\n+ 不依赖接口\n\n# 缺点\n+ 无法代理修饰 final \n","x":480,"y":220,"width":320,"height":222,"color":"3"}
	],
